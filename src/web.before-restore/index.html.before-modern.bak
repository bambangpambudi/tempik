<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#090812">
  <meta name="description" content="Artex Mail - Disposable email inbox">
  <title>Artex Mail</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='18' fill='%237c5cff'/%3E%3Cpath d='M12 19h40v28H12z M12 20l20 16 20-16' fill='none' stroke='white' stroke-width='4' stroke-linejoin='round'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="app">
    <header class="topbar">
      <div class="brand">
        <div class="brand-logo">A<span>✉</span></div>
        <div>
          <div class="brand-name" id="appTitle">Artex Mail</div>
          <div class="brand-caption">YOUR TEMPORARY INBOX</div>
        </div>
      </div>
      <div class="top-status"><span></span> ONLINE</div>
    </header>

    <main>
      <section id="homeSection" class="hero">
        <div class="hero-glow"></div>
        <div class="hero-label"><span>✦</span> EMAIL, SIMPLIFIED</div>
        <h1>Privasi dimulai<br>dari <span>satu inbox.</span></h1>
        <p id="appSubtitle">Email sementara, praktis dan mudah digunakan.</p>
        <div class="hero-stats">
          <div><span class="stat-icon">✉</span><span>Inbox instan</span></div>
          <div><span class="stat-icon">↻</span><span>Refresh mudah</span></div>
        </div>
      </section>

      <section id="inboxSection" class="section">
        <div class="section-title">
          <div>
            <div class="eyebrow">WORKSPACE</div>
            <h2>Inbox kamu</h2>
          </div>
          <div class="online-chip"><span></span> Aktif</div>
        </div>

        <div class="email-card">
          <div class="email-card-top">
            <div class="mail-symbol">✉</div>
            <div class="email-heading">
              <div class="eyebrow">ALAMAT EMAIL AKTIF</div>
              <div class="email-hint">Pilih inbox yang ingin digunakan</div>
            </div>
          </div>
          <select id="inboxSelect" aria-label="Pilih inbox"></select>

          <button id="copyBtn" class="copy-address">
            <span>▣</span> Salin alamat email <span class="copy-arrow">↗</span>
          </button>

          <div class="email-actions">
            <button id="refreshBtn" class="small-action"><span>↻</span> Refresh</button>
            <button id="deleteBtn" class="small-action delete-action"><span>×</span> Hapus</button>
          </div>
        </div>
      </section>

      <section id="createSection" class="section create-section">
        <div class="section-title">
          <div>
            <div class="eyebrow">QUICK ACTION</div>
            <h2>Buat email baru</h2>
          </div>
          <div class="create-icon">✦</div>
        </div>

        <div class="create-card">
          <p>Buat alamat pilihanmu sendiri atau biarkan Artex membuatkannya secara acak.</p>
          <button id="newBtn" class="create-toggle"><span>＋</span> Mulai buat email</button>

          <div id="newBox" class="new-box hidden">
            <label for="localPartInput">Nama alamat</label>
            <input id="localPartInput" placeholder="Contoh: namakamu" autocomplete="off">
            <label for="domainSelect">Domain email</label>
            <select id="domainSelect" aria-label="Pilih domain"></select>
            <button id="createCustomBtn" class="create-submit">Buat alamat ↗</button>
            <button id="createRandomBtn" class="random-submit">✦ Buat secara acak</button>
          </div>
        </div>
      </section>

      <section id="messagesSection" class="section">
        <div class="section-title">
          <div>
            <div class="eyebrow">MESSAGE CENTER</div>
            <h2>Pesan masuk</h2>
          </div>
          <span id="messageCount" class="count-chip">0 pesan</span>
        </div>

        <div class="messages-card">
          <div class="messages-address" id="currentInbox">Belum ada inbox</div>
          <div id="messageList" class="message-list"></div>
        </div>
      </section>

      <section id="settingsSection" class="section settings-section">
        <div class="section-title">
          <div>
            <div class="eyebrow">PREFERENCES</div>
            <h2>Tentang Artex</h2>
          </div>
        </div>
        <div class="settings-card">
          <div class="settings-logo">A✉</div>
          <div class="settings-copy">
            <strong>Artex Mail</strong>
            <p>Email sementara langsung dari browser kamu.</p>
          </div>
          <span class="version-chip">WEB APP</span>
        </div>
        <div class="settings-note">
          Jangan gunakan alamat sementara untuk akun penting atau menerima informasi sensitif. Ketersediaan pesan bergantung pada layanan dan penyimpanan aplikasi.
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-brand">ARTEX<span>MAIL</span></div>
      <p>Simple inbox. Less hassle.</p>
    </footer>
  </div>

  <nav class="bottom-nav" aria-label="Navigasi utama">
    <button class="nav-item active" data-target="messagesSection" aria-label="Inbox">
      <span class="nav-icon">▤</span><span>Inbox</span>
    </button>
    <button class="nav-item" data-target="createSection" aria-label="Buat email">
      <span class="nav-icon">＋</span><span>Buat Email</span>
    </button>
    <button class="nav-item" data-target="inboxSection" aria-label="Alamat">
      <span class="nav-icon">✉</span><span>Alamat</span>
    </button>
    <button class="nav-item" data-target="settingsSection" aria-label="Pengaturan">
      <span class="nav-icon">⚙</span><span>Info</span>
    </button>
  </nav>

  <div class="toast-container" id="toastContainer"></div>
  <script src="/app.js"></script>
</body>
</html>
