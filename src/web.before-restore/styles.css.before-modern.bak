@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #f7f4eb;
  --paper: #fffdf6;
  --ink: #171717;
  --muted: #73716a;
  --lime: #d8ff3e;
  --purple: #b9a0ff;
  --pink: #ff9eaa;
  --blue: #9edbff;
  --border: 2.5px solid var(--ink);
  --shadow: 5px 5px 0 var(--ink);
  --shadow-sm: 3px 3px 0 var(--ink);
  --radius: 18px;
}

* { box-sizing: border-box; }

html {
  min-height: 100%;
  scroll-behavior: smooth;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at 10% 5%, rgba(216,255,62,.18), transparent 24rem),
    var(--bg);
  color: var(--ink);
  font-family: 'Space Grotesk', system-ui, sans-serif;
  font-size: 14px;
  line-height: 1.55;
  padding-bottom: calc(100px + env(safe-area-inset-bottom));
}

button, input, select, textarea { font: inherit; }

button {
  color: inherit;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

button:focus-visible, input:focus-visible, select:focus-visible {
  outline: 3px solid #7855ff;
  outline-offset: 3px;
}

a { color: inherit; }
.hidden { display: none !important; }

.app {
  width: min(100% - 28px, 760px);
  margin: 0 auto;
  padding-top: 18px;
}

header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 24px;
}

header h1, header .brand-title, #appTitle {
  margin: 0;
  font-size: 25px;
  font-weight: 800;
  letter-spacing: -1.3px;
}

header h1 span, #appTitle span {
  display: inline-block;
  background: var(--lime);
  border: var(--border);
  padding: 0 7px;
  transform: rotate(-2deg);
}

.top-status, .status, .status-badge, .version-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  border: 2px solid var(--ink);
  border-radius: 999px;
  background: var(--paper);
  padding: 6px 10px;
  font-size: 11px;
  font-weight: 800;
}

.top-status::before, .status::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #55b84a;
  border: 1px solid var(--ink);
}

.hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 25px;
  padding: 27px 23px;
  border: 3px solid var(--ink);
  border-radius: 24px;
  background: var(--lime);
  box-shadow: 7px 7px 0 var(--ink);
}

.hero::after {
  content: "✳";
  position: absolute;
  right: 12px;
  top: -25px;
  font-size: 125px;
  line-height: 1;
  opacity: .13;
  pointer-events: none;
}

.eyebrow {
  display: inline-block;
  position: relative;
  z-index: 1;
  margin-bottom: 10px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.hero h1, .hero h2, .hero-title {
  position: relative;
  z-index: 1;
  max-width: 540px;
  margin: 0 0 12px;
  font-size: clamp(30px, 8vw, 49px);
  font-weight: 800;
  letter-spacing: -2.6px;
  line-height: 1.02;
}

.hero p {
  position: relative;
  z-index: 1;
  max-width: 440px;
  margin: 0;
  color: #34372a;
  font-size: 13px;
  font-weight: 600;
}

.hero-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 20px;
}

.hero-stats > *, .stat-chip {
  padding: 7px 10px;
  border: 2px solid var(--ink);
  border-radius: 8px;
  background: var(--paper);
  font-size: 11px;
  font-weight: 800;
}

section, .section { margin-bottom: 25px; }

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 13px;
}

.section-title h2, .section-title h3, .section h2 {
  margin: 0;
  font-size: 19px;
  font-weight: 800;
  letter-spacing: -.7px;
}

.section-title p {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 12px;
}

.email-card, .create-card, .messages-card, .settings-card,
.panel-card, .content-card {
  min-width: 0;
  padding: 18px;
  border: var(--border);
  border-radius: var(--radius);
  background: var(--paper);
  box-shadow: var(--shadow);
}

.email-card { margin-bottom: 20px; }

.email-card-top, .email-heading, .messages-address, .message-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.mail-symbol, .settings-logo {
  display: grid;
  flex-shrink: 0;
  place-items: center;
  width: 43px;
  height: 43px;
  border: var(--border);
  border-radius: 12px;
  background: var(--purple);
  font-size: 21px;
  font-weight: 800;
}

.email-heading { justify-content: flex-start; }

.email-heading h3, .email-card h3 {
  margin: 0;
  font-size: 16px;
  font-weight: 800;
}

.email-hint, .email-card p, .muted {
  color: var(--muted);
  font-size: 12px;
}

.email-address, #emailAddress, #currentEmail {
  overflow-wrap: anywhere;
  word-break: break-word;
  font-weight: 800;
}

.email-address {
  margin: 17px 0;
  padding: 13px;
  border: 2px dashed var(--ink);
  border-radius: 10px;
  background: #f1eee4;
  font-size: 14px;
}

.email-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 14px;
}

button, .btn, .action-button {
  min-height: 43px;
  padding: 10px 15px;
  border: var(--border);
  border-radius: 10px;
  background: var(--paper);
  font-weight: 800;
  transition: transform .12s ease, box-shadow .12s ease, background .12s ease;
}

button:hover, .btn:hover, .action-button:hover {
  transform: translate(-2px, -2px);
  box-shadow: var(--shadow-sm);
}

button:active, .btn:active, .action-button:active {
  transform: translate(2px, 2px);
  box-shadow: none;
}

.copy-address, .primary-button, .create-submit,
#copyBtn, #generateButton {
  background: var(--lime);
}

.delete-action, .danger-button { background: var(--pink); }

.small-action {
  min-height: 35px;
  padding: 7px 11px;
  font-size: 12px;
}

.create-card { background: var(--purple); }

.create-card > h2, .create-card > h3 {
  margin: 0 0 5px;
  font-size: 21px;
  font-weight: 800;
}

.create-card > p {
  margin: 0 0 18px;
  font-size: 12px;
}

.create-toggle {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 14px 0;
}

.create-toggle button, .create-toggle .active { background: var(--paper); }

.create-toggle button.active,
.create-toggle button[aria-pressed="true"] {
  background: var(--lime);
}

label {
  display: block;
  margin: 13px 0 6px;
  font-size: 12px;
  font-weight: 800;
}

input, select, textarea {
  display: block;
  width: 100%;
  min-height: 47px;
  padding: 12px 13px;
  border: 2px solid var(--ink);
  border-radius: 10px;
  background: var(--paper);
  color: var(--ink);
  font-size: 14px;
  font-weight: 600;
}

input::placeholder, textarea::placeholder { color: #88857c; }

input:disabled, select:disabled, button:disabled {
  cursor: not-allowed;
  opacity: .55;
}

.create-submit, .random-submit, form button[type="submit"] {
  width: 100%;
  margin-top: 14px;
}

.new-box {
  margin-top: 15px;
  padding: 15px;
  border: 2px solid var(--ink);
  border-radius: 12px;
  background: var(--paper);
}

.new-box.hidden { display: none; }

#inboxSelect, #messageList, #messagesList, .message-list { width: 100%; }

.message-list {
  display: grid;
  gap: 12px;
  margin-top: 15px;
}

.message-item, .message-card, .message-row {
  min-width: 0;
  padding: 15px;
  border: 2px solid var(--ink);
  border-radius: 13px;
  background: var(--paper);
  box-shadow: var(--shadow-sm);
}

.message-item h3, .message-card h3 {
  margin: 0;
  font-size: 14px;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.message-item p, .message-card p { overflow-wrap: anywhere; }

.message-meta {
  flex-wrap: wrap;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 11px;
}

.message-preview {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid #d8d4c8;
  font-size: 13px;
}

.empty-state {
  padding: 28px 15px;
  border: 2px dashed var(--ink);
  border-radius: 14px;
  background: #f0ede3;
  text-align: center;
}

.empty-state h3 {
  margin: 8px 0 4px;
  font-size: 16px;
  font-weight: 800;
}

.empty-state p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
}

.empty-state-icon { font-size: 35px; }

.settings-card { margin-bottom: 15px; }

.settings-card h3 {
  margin: 0 0 5px;
  font-size: 15px;
  font-weight: 800;
}

.settings-card p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
}

.settings-logo { background: var(--lime); }

.settings-copy { flex: 1; min-width: 0; }

.settings-note {
  margin-top: 12px;
  padding: 12px;
  border: 2px solid var(--ink);
  border-radius: 10px;
  background: var(--blue);
  font-size: 12px;
  font-weight: 600;
}

.version-chip {
  margin-left: auto;
  white-space: nowrap;
}

footer {
  margin: 32px 0 15px;
  color: var(--muted);
  text-align: center;
  font-size: 11px;
}

.footer-brand { color: var(--ink); font-weight: 800; }

.bottom-nav {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 7px;
  width: min(100% - 24px, 560px);
  margin: 0 auto;
  padding: 9px;
  padding-bottom: calc(9px + env(safe-area-inset-bottom));
  border: 3px solid var(--ink);
  border-bottom: 0;
  border-radius: 18px 18px 0 0;
  background: var(--paper);
  box-shadow: 0 -4px 0 rgba(23, 23, 23, .06);
}

.nav-item {
  display: flex;
  min-width: 0;
  min-height: 55px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  padding: 5px 2px;
  border: 2px solid transparent;
  border-radius: 11px;
  background: transparent;
  box-shadow: none;
  font-size: 10px;
  font-weight: 800;
}

.nav-item:hover {
  box-shadow: none;
  transform: none;
  background: #f0ede3;
}

.nav-item.active {
  border-color: var(--ink);
  background: var(--lime);
  box-shadow: 2px 2px 0 var(--ink);
}

.nav-icon { font-size: 19px; line-height: 1.3; }

.toast-container {
  position: fixed;
  z-index: 200;
  top: calc(12px + env(safe-area-inset-top));
  right: 12px;
  left: 12px;
  display: grid;
  justify-items: center;
  gap: 8px;
  pointer-events: none;
}

.toast {
  max-width: 440px;
  width: 100%;
  padding: 13px 16px;
  border: 2px solid var(--ink);
  border-radius: 12px;
  background: var(--lime);
  box-shadow: var(--shadow);
  color: var(--ink);
  font-size: 13px;
  font-weight: 800;
  opacity: 1;
  transition: opacity .25s ease, transform .25s ease;
}

.toast.error { background: var(--pink); }

.toast.fadeout {
  opacity: 0;
  transform: translateY(-8px);
}

.text-muted { color: var(--muted); }
.text-center { text-align: center; }
.flex { display: flex; }

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.gap-8 { gap: 8px; }
.w-full { width: 100%; }

@media (min-width: 700px) {
  .app { padding-top: 28px; }
  .hero { padding: 36px; }

  .email-card, .create-card, .messages-card, .settings-card {
    padding: 23px;
  }

  .bottom-nav {
    bottom: 18px;
    border-bottom: 3px solid var(--ink);
    border-radius: 18px;
    padding-bottom: 9px;
    box-shadow: 5px 5px 0 var(--ink);
  }

  body { padding-bottom: 125px; }
}

@media (max-width: 380px) {
  .app { width: calc(100% - 22px); }
  .hero { padding: 22px 17px; }

  .hero h1, .hero h2, .hero-title { font-size: 31px; }

  .email-card, .create-card, .messages-card, .settings-card {
    padding: 14px;
  }

  .bottom-nav {
    width: calc(100% - 16px);
    gap: 3px;
    padding-right: 5px;
    padding-left: 5px;
  }

  .nav-item { font-size: 9px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
    animation-duration: .01ms !important;
  }
}
